/*Copyright (C) 2025 QuantumNousThis program is free software: you can redistribute it and/or modifyit under the terms of the GNU Affero General Public License aspublished by the Free Software Foundation, either version 3 of theLicense, or (at your option) any later version.This program is distributed in the hope that it will be useful,but WITHOUT ANY WARRANTY; without even the implied warranty ofMERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See theGNU Affero General Public License for more details.You should have received a copy of the GNU Affero General Public Licensealong with this program. If not, see <https://www.gnu.org/licenses/>.For commercial licensing, please contact support@quantumnous.com*/import React, { useCallback, useContext, useEffect, useState }`n from 'react'`;`nimport { useTranslation }`n from 'react-i18next'`;`nimport {  Layout,  Card,  Typography,  TextArea,  Button,  Select,  Toast,  Spin,  Modal,}`n from '@douyinfe/semi-ui'`;`nimport { UserContext }`n from '../../context/User'`;`nimport {  API,  getUserIdFromLocalStorage,  processGroupsData,  showError,  renderGroupOption,  selectFilter,}`n from '../../helpers'`;`nimport { API_ENDPOINTS }`n from '../../constants/playground.constants'`;`nimport { useIsMobile }`n from '../../hooks/common/useIsMobile'`;`nimport SettingsPanel from '../../components/playground/SettingsPanel'`;`nimport FloatingButtons from '../../components/playground/FloatingButtons'`;`nimport { PlaygroundProvider }`n from '../../contexts/PlaygroundContext'`;`nconst { Title, Paragraph, Text } = Typography`;`nconst RATIO_OPTIONS = [  { label: '16:9', value: '16:9' },  { label: '9:16', value: '9:16' },  { label: '1:1', value: '1:1' },  { label: '4:3', value: '4:3' },]`;`nconst DURATION_OPTIONS = [  { label: '3 绉?, value: 3 },  { label: '5 绉?, value: 5 },  { label: '8 绉?, value: 8 },  { label: '10 绉?, value: 10 },]`;`nconst DEFAULT_FALLBACK_GROUP = 'default'`;`nconst normalizeErrorMessage = (error, fallbackMessage) => {  if (!error) return fallbackMessage`;`n  if (typeof error === 'string') return error`;`n  return error?.message || fallbackMessage;}`;`nconst resolveVideoUrl = (payload) => {  const candidates = [    payload?.data?.[0]?.url,    payload?.data?.[0]?.video_url,    payload?.data?.url,    payload?.data?.result_url,    payload?.url,    payload?.result?.url,    payload?.result?.video_url,    payload?.result_url,  ]`;`n  return candidates.find((item) => typeof item === 'string' && item.trim()) || '';}`;`nconst TextToVideo = () => {  const { t } = useTranslation()`;`n  const [userState] = useContext(UserContext)`;`n  const isMobile = useIsMobile()`;`n  const styleState = { isMobile };  // 浣跨敤涓?Playground 涓€鑷寸殑鐘舵€佺鐞?  const [inputs, setInputs] = useState({    model: '',    group: '',    ratio: '16:9',    duration: 5,    resolution: '720p',    seed: null,    prompt: '',  })`;`n  const [parameterEnabled, setParameterEnabled] = useState({    seed: false,  })`;`n  const [models, setModels] = useState([])`;`n  const [groups, setGroups] = useState([])`;`n  const [showSettings, setShowSettings] = useState(!isMobile)`;`n  const [showDebugPanel, setShowDebugPanel] = useState(false)`;`n  const [customRequestMode, setCustomRequestMode] = useState(false)`;`n  const [customRequestBody, setCustomRequestBody] = useState('')`;`n  const [previewPayload, setPreviewPayload] = useState(null);  // 瑙嗛灞曠ず鐘舵€?  const [loading, setLoading] = useState(false)`;`n  const [videoSrc, setVideoSrc] = useState('')`;`n  const [showGenerationPreview, setShowGenerationPreview] = useState(false)`;`n  const [previewVideo, setPreviewVideo] = useState(null)`;`n  const [previewVideo, setPreviewVideo] = useState(null)`;`n
  const [previewVideoBlobUrl, setPreviewVideoBlobUrl] = useState(null)`;`n  const loadGroups = useCallback(async () => {    try {      const res = await API.get(API_ENDPOINTS.USER_GROUPS)`;`n      const { success, message, data } = res.data`;`n      if (!success) {        showError(t(message))`;`n        return;      }`n      const userGroup =        userState?.user?.group ||        JSON.parse(localStorage.getItem('user') || '{}')?.group`;`n      const groupOptions = processGroupsData(data, userGroup)`;`n      setGroups(groupOptions)`;`n      const first = groupOptions[0]?.value || DEFAULT_FALLBACK_GROUP`;`n      setInputs((prev) => ({ ...prev, group: first }));    }`n catch (e) {      showError(t('鍔犺浇鍒嗙粍澶辫触'));    }  }, [t, userState?.user?.group]);  // 鍔犺浇鏂囩敓瑙嗛妯″瀷  const loadTextToVideoModels = useCallback(async () => {    try {      const res = await API.get(API_ENDPOINTS.USER_MODELS, {        params: { model_type: 3 },      })`;`n      const { success, message, data } = res.data`;`n      if (!success) {        showError(t(message))`;`n        return;      }`n      const modelList = Array.isArray(data) ? data : data?.items || []`;`n      const options = modelList        .map((item) => {          const value = item?.model_name || item?.model || item?.name || item?.modelName || item`;`n          return {            label: value,            value,          };        })        .filter((item) => item.value)`;`n      setModels(options)`;`n      if (options.length > 0) {        setInputs((prev) => ({ ...prev, model: options[0].value }));      }    }`n catch (e) {      showError(t('鍔犺浇妯″瀷澶辫触'));    }  }, [t])`;`n  useEffect(() => {    if (userState?.user) {      loadGroups()`;`n      loadTextToVideoModels();    }  }, [userState?.user, loadGroups, loadTextToVideoModels]);  // 澶勭悊杈撳叆鍙樺寲  const handleInputChange = useCallback((name, value) => {    setInputs((prev) => ({ ...prev, [name]: value }));  }, [])`;`n  const handleParameterToggle = useCallback((paramName) => {    setParameterEnabled((prev) => ({      ...prev,      [paramName]: !prev[paramName],    }));  }, []);  // 鐢熸垚瑙嗛  const handleGenerate = async () => {    const trimmed = inputs.prompt.trim()`;`n    if (!trimmed) {      showError(t('璇疯緭鍏ヨ棰戞弿杩?))`;`n      return;    }`n    if (!inputs.model) {      showError(t('鏆傛棤鍙敤鏂囩敓瑙嗛妯″瀷'))`;`n      return;    }`n    setLoading(true)`;`n    setShowGenerationPreview(true)`;`n    setVideoSrc('')`;`n    try {      const selectedGroup = inputs.group || DEFAULT_FALLBACK_GROUP`;`n      const body = {        model: inputs.model,        group: selectedGroup,        prompt: trimmed,        duration: inputs.duration,        // Note: Doubao Seedance models do not accept 'resolution' parameter.        // They use 'ratio' (aspect ratio) instead. Do not send resolution.        ratio: inputs.ratio,      }`;`n      const res = await fetch(API_ENDPOINTS.VIDEO_GENERATIONS, {        method: 'POST',        headers: {          'Content-Type': 'application/json',          'New-Api-User': getUserIdFromLocalStorage(),        },        body: JSON.stringify(body),      })`;`n      const text = await res.text()`;`n      let json`;`n      try {        json = JSON.parse(text);      }`n catch {        showError(t('鏂囩敓瑙嗛璇锋眰澶辫触'))`;`n        return;      }`n      if (!res.ok) {        const msg =          json?.error?.message ||          json?.message ||          text ||          t('鏂囩敓瑙嗛璇锋眰澶辫触')`;`n        showError(typeof msg === 'string' ? msg : t('鏂囩敓瑙嗛璇锋眰澶辫触'))`;`n        setShowGenerationPreview(false)`;`n        return;      }`n      const waitTask = async () => {        for (let i = 0`;`n i < 60`;`n i += 1) {          await new Promise((resolve) => setTimeout(resolve, 3000))`;`n          const taskRes = await fetch(`${API_ENDPOINTS.VIDEO_GENERATIONS}/${json?.task_id || json?.id}`, {            headers: {              'Content-Type': 'application/json',              'New-Api-User': getUserIdFromLocalStorage(),            },          })`;`n          const taskJson = await taskRes.json()`;`n          if (!taskJson) continue`;`n          const taskStatus = (taskJson?.status || taskJson?.data?.status || '').toLowerCase()`;`n          if (taskStatus === 'succeeded' || taskStatus === 'completed' || taskStatus === 'success' || taskStatus === 'done') {            const resolved = resolveVideoUrl(taskJson) || resolveVideoUrl(taskJson?.data)`;`n            if (resolved) {              return resolved;            }          }`n          if (taskStatus === 'failed' || taskStatus === 'error') {            throw new Error(taskJson?.error?.message || taskJson?.message || t('瑙嗛鐢熸垚澶辫触'));          }        }`n        return null;      }`;`n      const url = resolveVideoUrl(json)`;`n      if (url) {        setVideoSrc(url)`;`n        Toast.success(t('瑙嗛鐢熸垚瀹屾垚'));      }`n else {        const taskId = json?.task_id || json?.id`;`n        if (!taskId) {          showError(t('鏂囩敓瑙嗛璇锋眰澶辫触'))`;`n          setShowGenerationPreview(false)`;`n          return;        }`n        const completedUrl = await waitTask()`;`n        if (completedUrl) {          setVideoSrc(completedUrl)`;`n          Toast.success(t('瑙嗛鐢熸垚瀹屾垚'));        }`n else {          Toast.info(t('瑙嗛浠诲姟宸叉彁浜わ紝鐢熸垚鏃堕棿杈冮暱锛岃绋嶅悗鍒颁换鍔′腑蹇冩煡鐪嬬粨鏋?))`;`n          setShowGenerationPreview(false);        }      }    }`n catch (e) {      showError(e?.message || t('鏂囩敓瑙嗛璇锋眰澶辫触'))`;`n      setShowGenerationPreview(false);    }`n finally {      setLoading(false);    }  };  // 鎻愮ず璇嶇ず渚?  const promptExamples = [    {      title: '鍩庡競绌挎',      prompt: '璧涘崥鏈嬪厠涓栫晫锛岄湏铏圭伅涓嬶紝椋炶姹借溅锛岄珮閫熷垪杞﹀揩閫熼€氳繃銆?,      image: '/example/city-sunset.png',      video: '/example/world.mp4',    },    {      title: '娴疯竟鏃ヨ惤',      prompt: '澶曢槼瑗夸笅锛屾捣娴９鎸熺潃澶曢槼鐨勪綑鏅栨秾鍚戠編濂界殑宀歌竟銆?,      image: '/example/cat.png',      video: '/example/sun.mp4',    },    {      title: '绾㈣嫻鏋?,      prompt: '涓版敹鐨勫鑺傦紝绾㈠饯褰ょ殑鑻规灉琚竴鍙墜鎽樺彇浜嗐€?,      image: '/example/forest.png',      video: '/example/apple.mp4',    },    {      title: '鍧氭瘏鐨勭埛鐖?,      prompt: '甯︾潃甯藉瓙鐨勭埛鐖峰潥姣呭湴璧板悜浜嗗皬鏈ㄥ眿銆?,      image: '/example/garden.png',      video: '/example/grandpa.mp4',    },  ]`;`n  const handleExamplePromptClick = (item) => {    handleInputChange('prompt', item.prompt);  }`;`n  const handleExampleImageClick = (item) => {    setPreviewVideo(item);  };  // 鏋勫缓棰勮璇锋眰浣?  const constructPreviewPayload = useCallback(() => {    try {      const body = {        model: inputs.model,        group: inputs.group || undefined,        prompt: inputs.prompt,        duration: inputs.duration,        // Note: Doubao Seedance models do not accept 'resolution' parameter.        // They use 'ratio' (aspect ratio) instead. Do not send resolution.        ratio: inputs.ratio,      }`;`n      return body;    }`n catch (error) {      console.error('鏋勯€犻瑙堣姹備綋澶辫触:', error)`;`n      return null;    }  }, [inputs]);  // 鏋勫缓棰勮payload  useEffect(() => {    const timer = setTimeout(() => {      const preview = constructPreviewPayload()`;`n      setPreviewPayload(preview);    }, 300)`;`n    return () => clearTimeout(timer);  }, [inputs, constructPreviewPayload]);  // Playground Context 鍊?  const playgroundContextValue = {    onPasteImage: () => {},    imageUrls: [],    imageEnabled: false,  }`;`n  return (    <PlaygroundProvider value={playgroundContextValue}>      <div className='h-full'>        <Layout className='h-full bg-transparent flex flex-col md:flex-row'>          {(showSettings || !isMobile) && (            <Layout.Sider              className={`              bg-transparent border-r-0 flex-shrink-0 overflow-auto mt-[60px]              ${                isMobile                  ? 'fixed top-0 left-0 right-0 bottom-0 z-[1000] w-full h-auto bg-white shadow-lg'                  : 'relative z-[1] w-80 h-[calc(100vh-66px)]'              }            `}              width={isMobile ? '100%' : 320}            >              <SettingsPanel                inputs={inputs}`n                parameterEnabled={parameterEnabled}`n                models={models}                groups={groups}`n                styleState={styleState}`n                showSettings={showSettings}`n                showDebugPanel={showDebugPanel}`n                customRequestMode={customRequestMode}`n                customRequestBody={customRequestBody}`n                onInputChange={handleInputChange}`n                onParameterToggle={handleParameterToggle}`n                onCloseSettings={() => setShowSettings(false)}`n                onConfigImport={() => {}}`n                onConfigReset={() => {                  setInputs({                    model: inputs.model,                    group: inputs.group,                    ratio: '16:9',                    duration: 5,                    resolution: '720p',                    seed: null,                    prompt: '',                  })`;`n                  setParameterEnabled({                    seed: false,                  });                }}`n                onCustomRequestModeChange={setCustomRequestMode}`n                onCustomRequestBodyChange={setCustomRequestBody}`n                previewPayload={previewPayload}`n                messages={[]}`n                ratioOptions={RATIO_OPTIONS}                durationOptions={DURATION_OPTIONS}                hideParameterControl={true}                hideConfigManager={true}                hideImageUrlInput={true}              >                <Button                  theme='solid'                  type='primary'                  onClick={handleGenerate}`n                  loading={loading}                  disabled={loading || !inputs.model}                  block                  style={{ borderRadius: 4 }}                >                  {t('鐢熸垚瑙嗛')}                </Button>              </SettingsPanel>            </Layout.Sider>          )}          <Layout.Content className='relative flex-1 overflow-hidden'>            <div className='overflow-hidden flex flex-col lg:flex-row h-[calc(100vh-66px)] mt-[60px]'>              <div className='flex-1 flex flex-col'>                <div className='p-4 md:p-8 h-full overflow-y-auto'>                  <div                    style={{                      maxWidth: 1280,                      margin: '0 auto',                    }}                  >                    <Card                      style={{                        borderRadius: 8,                        boxShadow: '0 4px 12px rgba(1, 1, 32, 0.1)',                        background: 'rgba(255, 255, 255, 0.9)',                        height: '100%',                        minHeight: 500,                      }}                      bodyStyle={{ padding: 24, height: '100%', display: 'flex', flexDirection: 'column' }}                    >                      <div style={{ flex: 1, display: 'flex', flexDirection: 'column' }}>                        {/* 瑙嗛灞曠ず鍖?*/}                        <div style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 16 }}>                          {showGenerationPreview ? (                            <div                              style={{                                flex: 1,                                minHeight: 300,                                borderRadius: 8,                                overflow: 'hidden',                                background: '#f8fafc',                                border: '1px solid rgba(15,23,42,0.08)',                                display: 'flex',                                alignItems: 'center',                                justifyContent: 'center',                              }}                            >                              {loading && !videoSrc ? (                                <div style={{ textAlign: 'center' }}>                                  <Spin size='large' tip={t('姝ｅ湪鐢熸垚...')} />                                  <Paragraph type='tertiary' style={{ marginTop: 16 }}>                                    {t('瑙嗛姝ｅ湪鐢熸垚涓紝璇风◢鍊?)}                                  </Paragraph>                                </div>                              ) : videoSrc ? (                                <video                                  src={videoSrc}`n                                  controls                                  style={{                                    width: '100%',                                    height: '100%',                                    objectFit: 'contain',                                    display: 'block',                                    cursor: 'zoom-in',                                  }}`n                                  onClick={() => setPreviewVideo({ title: t('鐢熸垚瑙嗛棰勮'), video: videoSrc, prompt: inputs.prompt })}                                />                              ) : null}                            </div>                          ) : (                            <>                              {/* 瑙嗛绀轰緥鍖?*/}                              <div style={{ marginBottom: 8 }}>                                <Title heading={5}`n style={{ marginBottom: 8 }}>                                  {t('鐏靛厜涓€闂?)}                                </Title>                                <Paragraph type='tertiary' style={{ marginBottom: 0, fontSize: 14 }}>                                  {t('鐐瑰嚮鍗＄墖鍙皢鎻愮ず璇嶅～鍏ヨ緭鍏ユ锛岀洿鎺ヤ綋楠岀敓鎴愭晥鏋?)}                                </Paragraph>                              </div>                              <div                                style={{                                  display: 'grid',                                  gridTemplateColumns: 'repeat(2, 1fr)',                                  gap: 20,                                }}                              >                                {promptExamples.map((item) => (                                  <Card                                    key={item.title}                                    bodyStyle={{ padding: 0 }}`n                                    style={{                                      borderRadius: 8,                                      overflow: 'hidden',                                      background: '#fff',                                      border: '1px solid rgba(99, 102, 241, 0.12)',                                      cursor: 'pointer',                                      transition: 'transform 0.25s ease, box-shadow 0.25s ease',                                    }}`n                                    onMouseEnter={(e) => {                                      e.currentTarget.style.transform = 'translateY(-4px)'`;`n                                      e.currentTarget.style.boxShadow = '0 8px 24px rgba(1, 1, 32, 0.12)';                                    }}`n                                    onMouseLeave={(e) => {                                      e.currentTarget.style.transform = 'translateY(0)'`;`n                                      e.currentTarget.style.boxShadow = 'none';                                    }}`n                                    onClick={() => handleExamplePromptClick(item)}                                  >                                    <div                                      style={{                                        position: 'relative',                                        aspectRatio: '16 / 9',                                        overflow: 'hidden',                                        background: '#f1f5f9',                                      }}                                    >                                      <video                                        src={item.video}`n                                        muted                                        loop                                        playsInline                                        style={{                                          width: '100%',                                          height: '100%',                                          objectFit: 'cover',                                          display: 'block',                                          cursor: 'zoom-in',                                        }}`n                                        onClick={(e) => {                                          e.stopPropagation();                                          handleExamplePromptClick(item)`;`n                                          setPreviewVideo(item);                                        }}`n                                        onMouseEnter={(e) => e.currentTarget.play()}`n                                        onMouseLeave={(e) => {                                          e.currentTarget.pause()`;`n                                          e.currentTarget.currentTime = 0;                                        }}                                      />                                    </div>                                    <div                                      style={{ padding: 16 }}                                    >                                      <Text strong style={{ display: 'block', marginBottom: 6, fontSize: 15 }}>                                        {item.title}                                      </Text>                                      <Paragraph style={{ marginBottom: 0, fontSize: 14, lineHeight: 1.6 }}>                                        {item.prompt}                                      </Paragraph>                                    </div>                                  </Card>                                ))}                              </div>                            </>                          )}                        </div>                      </div>                    </Card>                  </div>                </div>              </div>            </div>            {/* 娴姩鎸夐挳 */}            <FloatingButtons              styleState={styleState}`n              showSettings={showSettings}`n              showDebugPanel={showDebugPanel}`n              onToggleSettings={() => setShowSettings(!showSettings)}`n              onToggleDebugPanel={() => setShowDebugPanel(!showDebugPanel)}            />          </Layout.Content>        </Layout>      </div>      {/* 瑙嗛棰勮 Modal */}      <Modal        title={previewVideo?.title || t('瑙嗛棰勮')}`n        visible={Boolean(previewVideo)}`n        onCancel={() => setPreviewVideo(null)}`n        footer={null}`n        centered        width={960}        bodyStyle={{ padding: 0, overflow: 'hidden', borderRadius: 8 }}      >        {previewVideo && (          <div style={{ background: '#0f172a' }}>            {previewVideo.video ? (              <video                src={previewVideo.video}`n                controls                style={{                  width: '100%',                  height: 'auto',                  maxHeight: '70vh',                  objectFit: 'contain',                  display: 'block',                }}              />            ) : (              <div style={{ width: '100%', aspectRatio: '16 / 10', overflow: 'hidden' }}>                <img                  src={previewVideo.image}`n                  alt={previewVideo.title}`n                  style={{                    width: '100%',                    height: '100%',                    objectFit: 'cover',                    display: 'block',                  }}                />              </div>            )}            {previewVideo.prompt && (              <div style={{ padding: 20, background: '#fff' }}>                <Text strong style={{ display: 'block', marginBottom: 8, fontSize: 16 }}>                  {t('鎻愮ず璇?)}                </Text>                <Paragraph style={{ marginBottom: 0, lineHeight: 1.75, fontSize: 15 }}>                  {previewVideo.prompt}                </Paragraph>              </div>            )}          </div>        )}      </Modal>    </PlaygroundProvider>  );}`;`nexport default TextToVideo;
